# Copy to .env. Never commit the copy. Node 22+ loads it through npm scripts.
# Local guests need no accounts or database; both online server and UI must run.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
ONLINE_SERVER_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
REGION=local
MAX_ROOMS=1
MAX_CONNECTIONS=24
# Private waiting rooms allocate no native arenas; empty/expired rooms are removed.
MAX_PRIVATE_LOBBIES=16
PRIVATE_LOBBY_TTL_SECONDS=600
RECONNECT_GRACE_SECONDS=30

# Optional durable storage. Leave blank for guest Casual-only development.
# Use direct PostgreSQL or a SESSION pooler (Supabase: port 5432), never 6543.
# Percent-encode the password. Do not include sslmode/sslcert query parameters.
DATABASE_URL=
# Production requires verify-full. Local Docker PostgreSQL is unencrypted.
DATABASE_SSL=
# Optional trusted CA PEM path; on Render use a secret file under /etc/secrets/.
DATABASE_CA_FILE=

# Required together with DATABASE_URL for real accounts and Ranked.
# Public values: Supabase project URL and publishable (or legacy anon) key only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The GitHub OAuth client secret goes ONLY in Supabase's provider dashboard.
# No app-managed SMTP is used; GitHub handles provider account recovery.
SEASON_ID=beta-1
# Optional complete rating configuration JSON. Omit when using defaults.
# A season's configuration is immutable; a changed version needs a new season.
# RATING_CONFIG_FILE=./server/rating-custom.json

# Optional Pages subpath, e.g. /rocket-arena-web. Empty for a root preview.
ROCKET_ARENA_BASE_PATH=
# Set only when serving dist locally after npm run build:
# ROCKET_ARENA_DIST=1
ROCKET_ARENA_LIVE_RELOAD=0
# Disposable database ONLY; never point tests at real player data.
# ONLINE_TEST_DATABASE_URL=postgresql://arena_dev:local-development-only@127.0.0.1:5432/arena_test
